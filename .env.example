# x402trace configuration
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit it.
#
# Mainnet RPC URLs MUST NOT be committed (CLAUDE.md hard rule #2). The
# placeholders below are intentionally left empty/commented; fill them
# in your local `.env` only.

# ─── Base network ───────────────────────────────────────────────

# Chain selector. Accepted values: `base-sepolia` (default), `base`, `84532`, `8453`.
# Also overridable per-command via `--chain base-sepolia` or `--chain base`.
BASE_CHAIN_ID=base-sepolia

# RPC URL for the chosen chain. Default for base-sepolia is
# `https://sepolia.base.org`; mainnet has NO default — supply your own.
BASE_RPC_URL=https://sepolia.base.org

# Mainnet RPC URL (leave commented; fill in only locally, never commit a
# populated value). x402trace v0.3 enables Base mainnet support per
# ADR-003; the operator supplies the RPC endpoint at runtime.
# BASE_CHAIN_ID=base
# BASE_RPC_URL=

# ─── x402 facilitator ───────────────────────────────────────────

# Testnet facilitator (x402.org default)
FACILITATOR_URL=https://x402.org/facilitator

# Alternative: Coinbase CDP facilitator (Base Sepolia)
# FACILITATOR_URL=https://api.developer.coinbase.com/rpc/v1/base-sepolia

# ─── Wallets ────────────────────────────────────────────────────

# Receiver wallet address (gets paid)
RECEIVER_ADDRESS=0x

# Payer wallet private key (TESTNET ONLY)
# Get testnet USDC from https://faucet.circle.com
PAYER_PRIVATE_KEY=0x

# ─── Logging ────────────────────────────────────────────────────

# Levels: trace, debug, info, warn, error
LOG_LEVEL=info

# ─── Proxy ──────────────────────────────────────────────────────

PROXY_PORT=8402

# ─── Reconciliation ─────────────────────────────────────────────

# How long after a facilitator failure to keep checking on-chain (seconds)
RECONCILIATION_WINDOW_SECONDS=60
